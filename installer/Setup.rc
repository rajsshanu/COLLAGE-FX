#include "resource.h"
#include <windows.h>

IDI_APP ICON "..\\studio\\MixedMedia.ico"

1 24 "setup.manifest"

IDR_STUDIO RCDATA "..\\dist\\MixedMediaStudio.exe"
IDR_PLUGIN RCDATA "..\\dist\\MixedMedia.ofx.bundle\\Contents\\Win64\\MixedMedia.ofx"
IDR_README RCDATA "..\\studio\\README.txt"
IDR_LICENSE RCDATA "..\\LICENSE"
IDR_NOTICES RCDATA "..\\THIRD_PARTY_NOTICES.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Mixed Media"
            VALUE "FileDescription", "Mixed Media Studio Setup"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "MixedMediaSetup"
            VALUE "LegalCopyright", "MIT licensed"
            VALUE "OriginalFilename", "MixedMediaSetup.exe"
            VALUE "ProductName", "Mixed Media Studio"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
